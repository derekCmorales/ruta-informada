---
// Tipografías autoalojadas (funcionan sin conexión): Poppins para títulos y cifras, DM Sans para el texto.
import "@fontsource/poppins/latin-500.css";
import "@fontsource/poppins/latin-600.css";
import "@fontsource/poppins/latin-700.css";
import "@fontsource-variable/dm-sans";
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { HOY } from "../data/content";
import { url, secUrl } from "../data/url";

interface Props { title?: string; description?: string; nav?: string }
const {
  title = "Ruta Informada",
  description = "Información oficial y verificada para personas migrantes del occidente de Guatemala y sus familias.",
  nav = "",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(url("og-image.jpg"), Astro.site);
const cur = (k: string) => (k === nav ? "page" : undefined);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#151A3D" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
    <link rel="apple-touch-icon" href={url("apple-touch-icon.png")} />
    <link rel="manifest" href={url("manifest.webmanifest")} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_GT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="top" id="top">
      <div class="offline" id="offline" role="status" hidden><div class="wrap"><Icon name="wifi-slash" /><span>Sin conexión. Está viendo la información revisada el {HOY}.</span></div></div>
      <div class="wrap bar">
        <a class="brand" href={url()} aria-label="Ruta Informada, ir al inicio"><span class="mark" aria-hidden="true"></span><b>Ruta <span>Informada</span></b></a>
        <nav class="nav" aria-label="Principal">
          <a class="navbtn desk" href={url("temas/")} aria-current={cur("temas")}>Temas</a>
          <a class="navbtn desk" href={url("ayuda/")} aria-current={cur("ayuda")}>Cómo usar</a>
          <a class="navbtn desk" href={url("buscar/")} aria-current={cur("buscar")}><Icon name="magnifying-glass" />Buscar</a>
          <button class="navbtn sizebtn" id="sizebtn" type="button" data-l="0" aria-label="Tamaño de letra: normal. Toque para agrandar">Aa <span class="lvl" aria-hidden="true"><i></i><i></i><i></i></span></button>
          <a class="navbtn sos desk" href={secUrl("S5", "sos-gt")}><Icon name="phone" />Emergencias</a>
        </nav>
      </div>
    </header>

    <main id="view"><slot /></main>

    <footer>
      <div class="weave" aria-hidden="true" style="--wbg:var(--paper)"></div>
      <div class="wrap">
        <div class="stack">
          <span class="brand" style="cursor:default"><span class="mark" aria-hidden="true"></span><b>Ruta <span>Informada</span></b></span>
          <p>Información, no asesoría legal. Confirme siempre con la institución oficial antes de hacer un trámite.</p>
          <p>Un proyecto de trabajo social de <a href="https://larasolutions.dev" target="_blank" rel="noopener">Lara Solutions</a>, agencia de software. Contenido revisado el <span class="num">{HOY}</span>.</p>
          <span class="ver">Versión 3</span>
        </div>
        <div class="links">
          <a href={url("temas/")}>Todos los temas</a>
          <a href={url("ayuda/")}>Cómo usar esta página</a>
          <a href={url("tarjeta/")}>Tarjeta para imprimir</a>
          <a href={url("cifras/")}>La migración en cifras</a>
          <a href={url("fuentes/")}>Fuentes consultadas</a>
          <a href={url("acerca/")}>Acerca del proyecto</a>
          <a href={url("privacidad/")}>Privacidad</a>
          <a href={url("creditos/")}>Créditos de imágenes</a>
          <a href={url("estado/")}>Estado del proyecto</a>
        </div>
      </div>
    </footer>

    <nav class="tabbar" aria-label="Navegación">
      <a class="tab" href={url()} aria-current={cur("home")}><Icon name="house" />Inicio</a>
      <a class="tab" href={url("temas/")} aria-current={cur("temas")}><Icon name="squares-four" />Temas</a>
      <a class="tab" href={url("ayuda/")} aria-current={cur("ayuda")}><Icon name="question" />Ayuda</a>
      <a class="tab" href={url("buscar/")} aria-current={cur("buscar")}><Icon name="magnifying-glass" />Buscar</a>
      <a class="tab sos" href={secUrl("S5", "sos-gt")} aria-current={cur("S5")}><Icon name="phone" />Emergencias</a>
    </nav>
    <div class="toast" id="toast" role="status" hidden></div>

    <script define:vars={{ swUrl: url("sw.js"), scope: url() + "/" }}>
      // Guardar la página para usarla sin internet (solo en https y fuera de una vista previa).
      try {
        if ("serviceWorker" in navigator && window.self === window.top && location.protocol === "https:") {
          navigator.serviceWorker.register(swUrl, { scope: scope.replace(/\/+$/, "/") }).catch(() => {});
        }
      } catch {}
    </script>
    <script>
      import "../scripts/global";
    </script>
  </body>
</html>
