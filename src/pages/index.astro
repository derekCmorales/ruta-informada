---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Photo from "../components/Photo.astro";
import Tile from "../components/Tile.astro";
import Pick from "../components/Pick.astro";
import ReturnsChart from "../components/ReturnsChart.astro";
import { PERSONAS, QUICK, SRC, HOY, secOf } from "../data/content";
import { url } from "../data/url";

const S = (id: string) => secOf(id)!;
const s8 = { id: "S8", t: "Fuentes consultadas", d: "De dónde sale cada dato y cuándo se revisó.", icon: "books" };
const chips = ["pasaporte", "cita consular", "visa H-2", "detenido", "retornados", "trata"];
const promises: [string, string][] = [
  ["books", "Cada dato tiene fuente y fecha."],
  ["scales", "No promovemos ni desalentamos la migración."],
  ["handshake", "Ninguna persona es ilegal. Hablamos de situación migratoria irregular."],
  ["lock-key", "No le rastreamos ni pedimos datos personales."],
  ["x", "No damos instrucciones para cruzar fronteras."],
  ["check", "Si un dato no se puede verificar, no se publica."],
];
const defaultPersona = PERSONAS[0].id;
---
<Base>
  <section class="hero">
    <Photo name="siete-orejas" alt="Volcán Siete Orejas sobre la cuenca del río Ocosito, en Quetzaltenango" eager />
    <div class="wrap">
      <div>
        <h1>Información clara para <em>cada etapa</em> del camino</h1>
        <p class="sub">Trámites, derechos y emergencias, con fuente oficial. Para personas migrantes del occidente y sus familias.</p>
      </div>
      <form class="finder" role="search" action={url("buscar/")} method="get">
        <label for="q">¿Qué necesita saber?</label>
        <div class="sbox"><Icon name="magnifying-glass" /><input id="q" name="q" type="search" placeholder="Ej.: pasaporte, consulado, detenido" autocomplete="off" enterkeyhint="search" /></div>
        <div class="chips">{chips.map((w) => <a class="chip" href={url(`buscar/?q=${encodeURIComponent(w)}`)}>{w}</a>)}</div>
        <p class="help">El buscador funciona en su teléfono, sin gastar datos.</p>
      </form>
    </div>
  </section>

  <section class="sosband" aria-labelledby="sos-l">
    <div class="wrap">
      <div class="lead" id="sos-l"><Icon name="phone" />Llamar ahora</div>
      {QUICK.map((q) => (
        <a class="sositem" href={`tel:${q.e164}`}><span class="n">{q.tel}</span><small><strong>{q.n}.</strong> {q.d}</small></a>
      ))}
    </div>
  </section>

  <section class="sec wrap" aria-labelledby="pers-h">
    <h2 class="h2 display" id="pers-h">¿En qué situación está?</h2>
    <p class="lede">Elija la que se parece a la suya. Le mostramos primero lo que más le sirve.</p>
    <div class="personas" role="group" aria-label="Situación">
      {PERSONAS.map((p) => (
        <button type="button" class="persona" data-persona={p.id} aria-pressed={String(p.id === defaultPersona)}><Icon name={p.icon} />{p.t}</button>
      ))}
    </div>
    {PERSONAS.map((p) => (
      <div class="picks" data-picks={p.id} hidden={p.id !== defaultPersona}>
        {p.picks.map((id) => <Pick id={id} />)}
      </div>
    ))}
  </section>

  <section class="sec wrap" style="padding-top:0" aria-labelledby="secs-h">
    <h2 class="h2 display" id="secs-h">Todo el contenido</h2>
    <div class="bento">
      <Tile s={S("S5")} kind="photo" />
      <Tile s={S("S1")} kind="photo" />
      <Tile s={S("S3")} kind="tint" />
      <Tile s={S("S2")} kind="photo" />
      <Tile s={S("S4")} kind="tint" />
      <Tile s={S("S6")} kind="photo" />
      <Tile s={S("S7")} kind="tint" />
      <Tile s={s8} kind="tint" />
    </div>
  </section>

  <section class="numbers" aria-labelledby="num-h">
    <div class="wrap sec">
      <h2 class="h2 display" id="num-h">La migración en cifras</h2>
      <p class="lede">Datos oficiales para entender la situación. No buscan animar ni desanimar a nadie.</p>
      <div class="numgrid">
        <div class="chartcard">
          <h3>Personas guatemaltecas retornadas por año</h3>
          <p class="cap">Desde Estados Unidos y México. Pase el dedo o el cursor sobre cada barra.</p>
          <ReturnsChart />
          <p class="srcline">Fuente: IGM, publicado por <a href={SRC.dcaRet.url} target="_blank" rel="noopener">Diario de Centro América</a> y <a href={SRC.euRet.url} target="_blank" rel="noopener">Emisoras Unidas</a>. Consultado el {HOY}.</p>
        </div>
        <div class="stats">
          <div class="stat" style="--bg:var(--magenta-t)"><span class="v">642</span><p>Niñas, niños y adolescentes retornados sin compañía en 2025.</p><span class="s">IGM vía <a href={SRC.dcaRet.url} target="_blank" rel="noopener">DCA</a></span></div>
          <div class="stat" style="--bg:var(--cobalt-t)"><span class="v">25,530<small> M</small></span><p>Dólares en remesas familiares en 2025, un 18.7% más que en 2024.</p><span class="s">Banguat vía <a href={SRC.remesas.url} target="_blank" rel="noopener">AGN</a></span></div>
          <div class="stat" style="--bg:var(--turq-t)"><span class="v">414</span><p>Personas migrantes muertas o desaparecidas en las Américas en 2025.</p><span class="s"><a href={SRC.oimMM.url} target="_blank" rel="noopener">OIM</a></span></div>
          <div class="stat" style="--bg:var(--maize-t)"><span class="v">1,276</span><p>Posibles víctimas de trata identificadas en Guatemala, de 2025 a abril de 2026.</p><span class="s">SVET vía <a href={SRC.svet.url} target="_blank" rel="noopener">Infobae</a></span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="band-h">
    <Photo name="xela" alt="Vista de la ciudad de Quetzaltenango desde El Baúl" />
    <div class="wrap">
      <div class="stack">
        <h2 class="display" id="band-h">Hecho en Xela, para el occidente</h2>
        <p>La información oficial existe, pero está dispersa y en lenguaje difícil. En ese vacío circulan rumores y estafas. Nosotros no creamos información nueva: la buscamos en la fuente, la revisamos y la escribimos claro.</p>
      </div>
      <div class="promises">
        {promises.map((p) => <div class="promise"><Icon name={p[0]} /><span>{p[1]}</span></div>)}
      </div>
    </div>
  </section>
</Base>

<script>
  // Selector de situación: recuerda la elección solo en este teléfono.
  const KEY = "ri-persona";
  const show = (id: string) => {
    const group = document.querySelector(`[data-picks="${id}"]`);
    if (!group) return;
    document.querySelectorAll<HTMLElement>("[data-picks]").forEach((g) => (g.hidden = g !== group));
    document.querySelectorAll(".persona").forEach((b) => b.setAttribute("aria-pressed", String((b as HTMLElement).dataset.persona === id)));
  };
  try { const saved = localStorage.getItem(KEY); if (saved) show(saved); } catch {}
  document.querySelectorAll<HTMLButtonElement>(".persona").forEach((b) =>
    b.addEventListener("click", () => {
      const id = b.dataset.persona!;
      show(id);
      try { localStorage.setItem(KEY, id); } catch {}
    }),
  );
</script>
