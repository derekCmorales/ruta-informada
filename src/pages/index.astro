---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Photo from "../components/Photo.astro";
import NeedCard from "../components/NeedCard.astro";
import { PERSONAS, QUICK, FREE, SECTIONS, SRC, S8, FOTOS, HERO_ALT, cvars, live } from "../data/content";
import { url, secUrl, blockUrl } from "../data/url";

const temas = [...SECTIONS, S8];
---
<Base nav="home">
  <section class="hero">
    <div class="wrap">
      <div class="txt">
        <h1>Información verdadera para <em>migrar, volver</em> o apoyar a su familia</h1>
        <p class="sub">Trámites, costos oficiales, derechos y a quién llamar. Gratis y con fuente oficial, para el occidente de Guatemala.</p>
        <div class="ctas">
          <a class="cta" href="#need-h" data-scroll="need-h">Ver lo que me sirve <Icon name="arrow-right" /></a>
          <a class="cta2" href={url("buscar/")}><Icon name="magnifying-glass" />Buscar un tema</a>
        </div>
        <p class="legal">Información, no asesoría legal. ¿Primera vez aquí? <a href={url("ayuda/")}>Vea cómo usar esta página</a>.</p>
      </div>
      <div class="heroimg">
        <Photo name={FOTOS.hero} alt={HERO_ALT} pos={FOTOS.heroPos} eager sizes="(max-width:900px) 100vw, 620px" maxWidth={1400} />
      </div>
    </div>
  </section>

  <section class="wrap" aria-labelledby="sos-h" style="padding-bottom:var(--s-8);margin-top:-24px">
    <div class="sosbox">
      <div>
        <h2 id="sos-h">Llamar ahora</h2>
        <p>Toque un número para llamar. Las líneas de Guatemala son gratuitas.</p>
        <a class="linkbtn" style="margin-top:8px" href={secUrl("S5", "sos-gt")}>Todos los números <Icon name="arrow-right" /></a>
      </div>
      <div class="soslist">
        {QUICK.map((q) => (
          <a class="sositem" href={`tel:${q.e164}`} aria-label={`Llamar al ${q.tel}, ${q.n}`}>
            <span class="n"><Icon name="phone" />{q.tel}</span>
            <small><b>{q.n}</b>{q.d}</small>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap" aria-labelledby="need-h" style="padding-bottom:var(--s-8)">
    <div class="sechead">
      <span class="eyebrow">Empiece aquí</span>
      <h2 class="h2" id="need-h" style="scroll-margin-top:calc(var(--hh) + 24px)">¿Qué está viviendo?</h2>
      <p class="lede">Elija su situación. Le mostramos primero lo que más preguntan las personas en su lugar.</p>
    </div>
    <p class="swipe" aria-hidden="true">Deslice para ver las cinco <Icon name="arrow-right" /></p>
    <div class="needs">{PERSONAS.map((p) => <NeedCard p={p} />)}</div>
  </section>

  <section class="wrap" aria-labelledby="free-h" style="padding-bottom:var(--s-8)">
    <div class="sechead">
      <span class="eyebrow">Antes de pagarle a alguien</span>
      <h2 class="h2" id="free-h">Esto es gratis. Nadie debe cobrarle.</h2>
      <p class="lede">La mayoría de estafas cobra por algo que no cuesta nada.</p>
    </div>
    <div class="free">
      {FREE.map((f) => (
        <a class="freeit" href={blockUrl(f[0])}>
          <span class="q"><Icon name="check-circle" />Gratis</span>
          <b>{f[1]}</b>
          <span>{f[2]}</span>
          <span class="go">Ver detalles <Icon name="arrow-right" /></span>
        </a>
      ))}
    </div>
    <div class="freeband">
      <Icon name="warning-octagon" />
      <p><b>Lo oficial que sí cuesta se paga en el banco, nunca a una persona.</b> El pasaporte se paga solo en Banrural: USD 50 por 5 años. <a class="linkbtn" style="color:var(--pink-l);padding:0" href={blockUrl("pago-oficial")}>Dónde se paga cada cosa</a></p>
    </div>
  </section>

  <section class="wrap" aria-labelledby="secs-h" style="padding-bottom:var(--s-8)">
    <div class="sechead"><span class="eyebrow">Todo el contenido</span><h2 class="h2" id="secs-h">Temas</h2></div>
    <div class="tlist">
      {temas.map((s) => (
        <a class="trow" style={cvars(s.id)} href={secUrl(s.id)}>
          <span class="ti"><Icon name={s.icon} /></span>
          <span><b>{s.t}</b><small>{s.d}</small></span>
          <span class="cnt">{"blocks" in s ? live(s) : Object.keys(SRC).length} <Icon name="arrow-right" /></span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap" style="padding-bottom:var(--s-8)">
    <div class="trust">
      <div><Icon name="seal-check" /><p><b>Fuente oficial en cada dato</b><span>Con el nombre de la institución y la fecha en que se revisó.</span></p></div>
      <div><Icon name="lock-key" /><p><b>Sin registro ni datos personales</b><span>No pedimos su nombre ni su teléfono. No usamos cookies.</span></p></div>
      <div><Icon name="scales" /><p><b>No promovemos ni desalentamos la migración</b><span>Le damos la información para que usted decida. <a class="linkbtn" style="padding:0" href={url("acerca/")}>Quiénes somos</a></span></p></div>
    </div>
  </section>
</Base>
