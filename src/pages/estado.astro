---
import PlainPage from "../components/PlainPage.astro";
import Icon from "../components/Icon.astro";
import { SECTIONS, STATE } from "../data/content";

const total = SECTIONS.reduce((a, s) => a + s.blocks.length, 0);
const pend = SECTIONS.reduce((a, s) => a + s.blocks.filter((b) => b.pending).length, 0);
const crit: [string, string][] = [
  ["y", "Las ocho secciones existen y tienen contenido con fuente"],
  ["p", `Contenido verificado: ${total - pend} de ${total} bloques publicados, todos pendientes de 2.ª revisión`],
  ["y", "Cada bloque muestra fuente y fecha de consulta"],
  ["n", "Abre sin conexión en modo avión (necesita service worker en GitHub Pages)"],
  ["n", "Se instala en Android (manifest y service worker)"],
  ["y", "El buscador funciona sin llamadas de red"],
  ["y", "Teléfonos marcables con un toque"],
  ["y", "Imágenes optimizadas automáticamente por Astro (WebP en varios tamaños)"],
  ["n", "Carga en menos de 3 s en conexión lenta simulada (medir)"],
  ["y", "Aviso de “no es asesoría legal” visible sin desplazarse"],
  ["n", "Probado en tres dispositivos, con capturas"],
  ["p", "Enlace público en GitHub Pages. Falta QR y dominio final"],
  ["y", "Repositorio público con código y contenidos"],
];
const dec: [string, string][] = [
  ["Nombre", "Ruta Informada (recomendación del documento). Confirmar con el equipo."],
  ["Tecnología", "Astro, sitio estático. El contenido está en src/data/content.ts, separado del diseño."],
  ["¿Incluir S4?", "Incluida con enfoque de protección: solo datos y dónde pedir ayuda."],
  ["Contador", "Propuesta: GoatCounter, sin cookies. Decidir antes de publicar."],
  ["Rutas", "Guatemala, México y Estados Unidos."],
  ["Fotografías", "Solo paisajes y tejidos con licencia libre, sin personas."],
  ["Versión imprimible", "Pendiente."],
];
---
<PlainPage title="Estado del proyecto" lede="Avance frente a los criterios de aceptación. Esta página es para el equipo y se retira antes del lanzamiento.">
  <div class="stack" style="max-width:900px">
    <div class="tbl"><table><tbody>
      {crit.map((c) => <tr><td><i class:list={["chk", c[0] !== "n" && c[0]]}></i>{c[1]}</td></tr>)}
    </tbody></table></div>
    <h3>Decisiones tomadas</h3>
    <div class="tbl"><table>
      <thead><tr><th>Tema</th><th>Estado</th></tr></thead>
      <tbody>{dec.map((d) => <tr><td><strong>{d[0]}</strong></td><td>{d[1]}</td></tr>)}</tbody>
    </table></div>
    <article class="block" style="--c:var(--maize);--bg:var(--maize-t)">
      <div class="bhead"><span class="bico"><Icon name="check" /></span><h3 style="padding-top:9px">Siguiente paso de verificación</h3></div>
      <p>Cada bloque dice “{STATE}”. Dos integrantes deben abrir la fuente original, confirmar el dato y cambiar el estado a “Verificado” con su fecha. Prioridad: S5 (teléfonos) y S1 (costos). Los sitios del MINEX y del IGM no permiten lectura automática, así que esa revisión debe hacerse a mano.</p>
    </article>
  </div>
</PlainPage>
