---
import PlainPage from "../components/PlainPage.astro";
import Photo from "../components/Photo.astro";
import { IMAGES, IMAGENES_IA } from "../data/content";
const lede = IMAGENES_IA ? "Las imágenes fueron generadas con inteligencia artificial y no muestran a personas reales. Algunas están recortadas." : "Algunas imágenes están recortadas.";
---
<PlainPage title="Créditos de imágenes" lede={lede}>
  <div class="credits">
    {IMAGES.map((i) => (
      <div class="credit">
        <Photo name={i.f} sizes="300px" maxWidth={700} />
        <div><strong>{i.t}</strong><br />{i.a}{i.u && <>, <a href={i.u} target="_blank" rel="noopener">{i.l}</a></>}</div>
      </div>
    ))}
  </div>
</PlainPage>
