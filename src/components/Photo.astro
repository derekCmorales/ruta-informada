---
// Imagen optimizada por Astro (webp, varios tamaños, srcset).
import { Image } from "astro:assets";
import { IMG, ILUS } from "../data/images";
interface Props { name: string; alt?: string; sizes?: string; eager?: boolean; class?: string; maxWidth?: number; pos?: string; ilus?: boolean }
const { name, alt = "", sizes = "100vw", eager = false, class: cls, maxWidth = 2000, pos, ilus = false } = Astro.props;
const src = (ilus ? ILUS : IMG)[name];
if (!src) throw new Error(`Imagen no encontrada: ${name}`);
const top = Math.min(src.width, maxWidth);
const widths = [400, 700, 1000, 1400, 2000, 2560].filter((w) => w < top);
widths.push(top);
---
<Image
  src={src}
  alt={alt}
  widths={widths}
  width={top}
  height={Math.round((src.height * top) / src.width)}
  sizes={sizes}
  class={cls}
  style={pos ? `object-position:${pos}` : undefined}
  loading={eager ? "eager" : "lazy"}
  fetchpriority={eager ? "high" : "auto"}
  decoding={eager ? "sync" : "async"}
/>
