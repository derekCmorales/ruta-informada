---
// Gráfica de barras de personas retornadas por año (una serie, SVG estático + tooltip).
const data = [
  { y: "2023", v: 55302, note: "470 vuelos" },
  { y: "2024", v: 61680, note: "508 vuelos" },
  { y: "2025", v: 55181, note: "48,405 desde EE. UU. y 6,776 desde México" },
];
const W = 560, H = 260, m = { t: 28, r: 8, b: 34, l: 58 };
const iw = W - m.l - m.r, ih = H - m.t - m.b, max = 70000;
const y = (v: number) => m.t + ih - (v / max) * ih;
const band = iw / data.length, bw = Math.min(72, band * 0.52);
const fmt = (n: number) => n.toLocaleString("en-US");
const ticks = [0, 20000, 40000, 60000];
const bars = data.map((d, i) => {
  const x = m.l + band * i + (band - bw) / 2, top = y(d.v), r = 4;
  const path = `M${x},${m.t + ih} V${top + r} Q${x},${top} ${x + r},${top} H${x + bw - r} Q${x + bw},${top} ${x + bw},${top + r} V${m.t + ih} Z`;
  return { ...d, i, x, top, path, hit: m.l + band * i, fill: i === 2 ? "#D6246E" : "#2346C8" };
});
---
<div class="chart" id="chart-ret">
  <svg viewBox={`0 0 ${W} ${H}`} role="group" aria-label="Personas retornadas por año">
    {ticks.map((t) => (
      <>
        <line x1={m.l} x2={W - m.r} y1={y(t)} y2={y(t)} stroke="#E3E2DC" stroke-width="1" />
        <text x={m.l - 10} y={y(t) + 5} text-anchor="end" font-size="13" fill="#5E6485" font-family="DM Sans Variable,DM Sans,sans-serif" style="font-variant-numeric:tabular-nums">{fmt(t)}</text>
      </>
    ))}
    {bars.map((b) => (
      <g class="bar" tabindex="0" role="button" aria-label={`${b.y}: ${fmt(b.v)} personas. ${b.note}`} data-label={`${b.y}: <b>${fmt(b.v)}</b><br>${b.note}`}>
        <rect x={b.hit} y={m.t} width={band} height={ih} fill="transparent" />
        <path d={b.path} fill={b.fill} />
        <text x={b.x + bw / 2} y={b.top - 9} text-anchor="middle" font-size="15" font-weight="700" fill="#151A3D" font-family="DM Sans Variable,DM Sans,sans-serif" style="font-variant-numeric:tabular-nums">{fmt(b.v)}</text>
        <text x={b.x + bw / 2} y={H - 10} text-anchor="middle" font-size="14" fill="#3C4266" font-family="DM Sans Variable,DM Sans,sans-serif" font-weight="700">{b.y}</text>
      </g>
    ))}
    <line x1={m.l} x2={W - m.r} y1={m.t + ih} y2={m.t + ih} stroke="#9AA0BC" stroke-width="1" />
  </svg>
  <div class="tt" role="tooltip"></div>
  <table class="sr">
    <caption>Personas retornadas por año</caption>
    <tr><th>Año</th><th>Personas</th></tr>
    {data.map((d) => <tr><td>{d.y}</td><td>{d.v}</td></tr>)}
  </table>
</div>

<script>
  const el = document.getElementById("chart-ret");
  if (el) {
    const tt = el.querySelector<HTMLElement>(".tt")!;
    el.querySelectorAll<SVGGElement>(".bar").forEach((b) => {
      const show = () => {
        const br = b.querySelector("path")!.getBoundingClientRect(), er = el.getBoundingClientRect();
        tt.innerHTML = b.dataset.label ?? "";
        tt.style.left = br.left - er.left + br.width / 2 + "px";
        tt.style.top = br.top - er.top + "px";
        tt.style.opacity = "1";
      };
      b.addEventListener("pointerenter", show);
      b.addEventListener("pointerdown", show);
      const hide = () => (tt.style.opacity = "0");
      b.addEventListener("pointerleave", hide);
      b.addEventListener("focus", show);
      b.addEventListener("blur", hide);
    });
  }
</script>
