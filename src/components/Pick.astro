---
import { BLOCKS, cvars } from "../data/content";
import { blockUrl } from "../data/url";
import Icon from "./Icon.astro";
interface Props { id: string }
const x = BLOCKS[Astro.props.id];
---
{x && (
  <a class="pick" style={cvars(x.s.id)} href={blockUrl(x.b.id)}>
    <span class="where">{x.s.t}</span>
    <b>{x.b.h}</b>
    <Icon name="arrow-right" class="go" />
  </a>
)}
