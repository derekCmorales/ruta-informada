---
import { SRC, HOY, STATE } from "../data/content";
import Icon from "./Icon.astro";
interface Props { keys: string[] }
const { keys } = Astro.props;
---
<p class="src">
  Fuente: {keys.map((k, i) => (
    <>{i > 0 && ", "}<a href={SRC[k].url} target="_blank" rel="noopener">{SRC[k].inst}</a></>
  ))}. Consultado el <span class="num">{HOY}</span>.
  <span class="state" title="Dos integrantes del equipo deben revisar la fuente original antes de marcar este dato como verificado"><Icon name="hourglass" />{STATE}</span>
</p>
