// Cloudflare Workers: publica la carpeta dist como sitio estático.
// worker/index.js va delante: redirige a HTTPS y al dominio principal, y agrega el charset.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ruta-informada",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
